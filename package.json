{
  "name": "portfolio-next",
  "version": "1.0.0",
  "private": true,
  "description": "Sashank Deb's portfolio, rebuilt in Next.js + TypeScript with Server Components and TDD.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "check:branch": "node scripts/check-branch.ts",
    "check:commits": "node scripts/check-commits.ts",
    "lighthouse:run": "node scripts/lighthouse-run.ts",
    "lighthouse:compare": "node scripts/lighthouse-compare.ts"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/compat": "^2.1.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@iconscout/unicons": "^4.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "globals": "^17.14.0",
    "husky": "9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lighthouse": "13.6.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
